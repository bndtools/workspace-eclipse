# OSGi R8 API repository
# Maven Central backed repository; artifacts are listed in osgi-api.mvn.
-plugin.osgi.api: \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        snapshotUrl = "https://oss.sonatype.org/content/repositories/snapshots/"; \
        releaseUrl  = "https://repo.maven.apache.org/maven2/"; \
        index       = ${.}/osgi-api.mvn; \
        readOnly    = true; \
        name        = "OSGi R8 API"

# Whole OSGi R8 API as -buildpath entries, e.g.
#   -buildpath: ${osgi.api}
# Lists the individual org.osgi.* API bundles from osgi-api.mvn. The aggregate
# jars (osgi.core, osgi.enterprise, osgi.annotation, osgi.promise) are omitted
# because they duplicate the same packages. Keep in sync with osgi-api.mvn.
osgi.api: \
    org.osgi.annotation.bundle;version=2.0.0,\
    org.osgi.annotation.versioning;version=1.1.2,\
    org.osgi.application;version=1.0.0,\
    org.osgi.dto;version=1.1.1,\
    org.osgi.framework;version=1.10.0,\
    org.osgi.jmx;version=1.1.0,\
    org.osgi.namespace.contract;version=1.0.0,\
    org.osgi.namespace.extender;version=1.0.1,\
    org.osgi.namespace.implementation;version=1.0.0,\
    org.osgi.namespace.service;version=1.0.0,\
    org.osgi.namespace.unresolvable;version=1.0.0,\
    org.osgi.resource;version=1.0.1,\
    org.osgi.service.application;version=1.1.0,\
    org.osgi.service.async;version=1.0.0,\
    org.osgi.service.blueprint;version=1.0.2,\
